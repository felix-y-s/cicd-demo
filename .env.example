# ── 애플리케이션 ──────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGIN=http://localhost:3000

# ── PostgreSQL (Prisma) — docker-compose postgres 서비스 ──
DATABASE_URL=postgresql://nest:nest@localhost:5432/nest_template?schema=public

# ── MongoDB (Mongoose) — docker-compose mongodb 서비스 ──
MONGODB_URI=mongodb://nest:nest@localhost:27017/nest_template?authSource=admin

# ── Redis — docker-compose redis 서비스 ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=nest

# ── RabbitMQ — docker-compose rabbitmq 서비스 ──
RABBITMQ_URL=amqp://nest:nest@localhost:5672
RABBITMQ_CHANNEL_POOL_SIZE=5

# ── JWT 인증 (32자 이상 필수) ──────────────────
JWT_SECRET=dev-only-change-me-to-a-random-32-char-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-only-change-me-refresh-32-char-secret
JWT_REFRESH_EXPIRES_IN=7d

# ── 보안 ──────────────────────────────────────
BCRYPT_SALT_ROUNDS=10

# ── 로깅 ──────────────────────────────────────
LOG_LEVEL=debug
LOG_DIR=logs
LOG_MAX_FILES=30d
LOG_MAX_SIZE=20m

# ── Swagger ───────────────────────────────────
SWAGGER_ENABLED=true
SWAGGER_PATH=api-docs

# ── Rate Limiting (Throttler) ─────────────────
THROTTLE_SHORT_TTL=1000
THROTTLE_SHORT_LIMIT=3
THROTTLE_MEDIUM_TTL=10000
THROTTLE_MEDIUM_LIMIT=20
THROTTLE_LONG_TTL=60000
THROTTLE_LONG_LIMIT=100
